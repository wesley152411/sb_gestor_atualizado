# Variáveis do SB Gestor — SEM VALORES. Copie para .env.local e preencha.
# O .env.local é ignorado pelo git; este arquivo é versionado de propósito, para
# quem clonar saber o que precisa existir.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Rate limiting (rotas públicas) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Mercado Pago (assinatura recorrente, Checkout Pro / Preapproval) ---
# NUNCA use o prefixo NEXT_PUBLIC_ em nada abaixo: ele embute o valor no bundle
# do navegador. Há prova estática disso em tests/static/mercadopago-chaves.test.ts.
#
# Token de TESTE começa com "TEST-"; o de produção, com "APP_USR-". O código
# recusa credencial incoerente com o ambiente nos DOIS sentidos: produção em
# ambiente de teste cobraria de verdade, e teste em produção não cobraria ninguém
# sem ninguém perceber.
MP_ACCESS_TOKEN=
# Só faz falta em Checkout Transparente/Bricks. Com Checkout Pro fica sem uso.
MP_PUBLIC_KEY=
# Assinatura secreta do webhook. É POR URL cadastrada no painel: a de produção e
# a do túnel de teste são diferentes.
MP_WEBHOOK_SECRET=
# Force o ambiente quando o NODE_ENV não bastar (ex.: preview deploy da Netlify).
# Valores aceitos: teste | producao. Qualquer outra coisa é ignorada.
MP_AMBIENTE=

# Pepper do HMAC das âncoras de benefício (teste grátis / oferta de retenção).
# Segredo. NUNCA no banco: o espaço de CNPJs é enumerável, e sem o pepper o hash
# seria reversível por força bruta. Trocar este valor INVALIDA o histórico.
BENEFICIOS_PEPPER=

# Segredo que o job de reconciliação usa para chamar POST /api/billing/reconcile.
RECONCILE_TOKEN=
