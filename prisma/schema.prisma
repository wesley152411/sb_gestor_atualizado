generator client {
  provider = "prisma-client-js"
  // native = ambiente local (Windows); rhel-openssl = Netlify Functions (AWS Lambda).
  // Sem isso, o Prisma Client não roda no deploy.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Decorator {
  id                                                  String          @id @default(uuid())
  name                                                String
  avatar_url                                          String?
  membership_level                                    String?         @default("Membro")
  location                                            String?
  created_at                                          DateTime        @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  instagram                                           String?
  whatsapp                                            String?
  phone                                               String?
  about                                               String?
  cover_url                                           String?
  logo_url                                            String?
  reach                                               Int?            @default(0)
  contact_rate                                        Decimal?        @default(0.0) @db.Decimal
  positive_reviews                                    Int?            @default(0)
  // Template da mensagem promocional (reativação por WhatsApp). Variável: {nome}.
  promo_message_template                              String?
  // CNPJ (14 dígitos, sem máscara) e razão/nome da empresa. Movidos do metadata do
  // Auth para ficarem queryáveis (cobrança/NF) e cobertos pela cascata de exclusão.
  cnpj                                                String?
  company_name                                        String?
  // Conta interna de teste: apenas OCULTA das listagens públicas (vitrine do
  // Marketplace e contatos do Chat). NUNCA é exceção de isolamento — a conta
  // continua sujeita a 401/403 como qualquer outra. Definível SÓ no banco.
  is_internal                                         Boolean         @default(false)
  // Pedido explícito no gate de documentos legais. A exclusão é manual e feita
  // pelo script de exclusão total; este timestamp apenas põe a conta na fila.
  deletion_requested_at                               DateTime?       @db.Timestamptz(6)
  chat_messages_chat_messages_receiver_idTodecorators ChatMessage[]   @relation("chat_messages_receiver_idTodecorators")
  chat_messages_chat_messages_sender_idTodecorators   ChatMessage[]   @relation("chat_messages_sender_idTodecorators")
  clients                                             Client[]
  consumables                                         consumables[]
  forum_posts                                         forum_posts[]
  inventory_items                                     InventoryItem[]
  kits                                                Kit[]
  party_events                                        PartyEvent[]
  client_promo_messages                               ClientPromoMessage[]
  legal_acceptances                                   LegalAcceptance[]
  subscriptions                                       Subscription[]
  rental_orders_rental_orders_owner_idTodecorators    RentalOrder[]   @relation("rental_orders_owner_idTodecorators")
  rental_orders_rental_orders_renter_idTodecorators   RentalOrder[]   @relation("rental_orders_renter_idTodecorators")

  @@map("decorators")
}

// Registro imutável de aceite dos documentos legais. Não há endpoint de edição
// ou exclusão; a tabela só desaparece na exclusão total da decoradora.
model LegalAcceptance {
  id           String    @id @default(uuid())
  decorator_id String
  document     String
  version      String
  content_hash String
  accepted_at  DateTime  @default(dbgenerated("now()")) @db.Timestamptz(6)
  ip           String?
  user_agent   String?
  context      String    @default("signup")
  decorators   Decorator @relation(fields: [decorator_id], references: [id], onDelete: Cascade)

  @@index([decorator_id, document, version], map: "idx_legal_acc_lookup")
  @@map("legal_acceptances")
}

// Assinatura recorrente no Mercado Pago (Preapproval). Espelho LOCAL: a verdade
// é sempre relida com GET /preapproval/{id}, nunca do corpo do webhook.
//
// ATENÇÃO: o banco tem um índice ÚNICO PARCIAL (idx_subscriptions_vigente) que
// garante uma linha vigente por decoradora. Prisma não sabe expressar índice
// parcial, então ele NÃO aparece aqui — a violação chega como erro cru do
// Postgres, não como erro tipado. Não remova o índice achando que é resíduo.
model Subscription {
  id                   String    @id @default(uuid())
  decorator_id         String
  mp_preapproval_id    String    @unique
  mp_payer_id          String?
  // vigente = a linha que o gate lê; status = o que o MP diz. Perguntas diferentes:
  // juntá-las quebrava o cancelar-e-reativar dentro do período já pago.
  vigente              Boolean   @default(false)
  status               String    @default("pendente")
  plano                String    @default("mensal")
  // DESEJADO vs CONFIRMADO — o PUT de valor no MP é assíncrono e perdível
  // (medido: 4 de 5 rajadas voltaram ao valor original com HTTP 200).
  valor_centavos       Int
  valor_centavos_mp    Int?
  sincronizado_em      DateTime? @db.Timestamptz(6)
  tentativas_sync      Int       @default(0)
  teste_fim            DateTime? @db.Timestamptz(6)
  periodo_fim          DateTime? @db.Timestamptz(6)
  proxima_cobranca     DateTime? @db.Timestamptz(6)
  cobrancas_no_plano   Int       @default(0)
  primeira_cobranca_em DateTime? @db.Timestamptz(6)
  oferta_retencao_em   DateTime? @db.Timestamptz(6)
  cancelada_em         DateTime? @db.Timestamptz(6)
  motivo_cancelamento  String?
  criada_em            DateTime  @default(dbgenerated("now()")) @db.Timestamptz(6)
  atualizada_em        DateTime  @default(dbgenerated("now()")) @db.Timestamptz(6)
  decorators           Decorator @relation(fields: [decorator_id], references: [id], onDelete: Cascade)

  @@index([decorator_id], map: "idx_subscriptions_decorator")
  @@map("subscriptions")
}

// Notificações do webhook, cruas. O id é o da NOTIFICAÇÃO no Mercado Pago: a
// retentativa traz o mesmo id, o INSERT conflita e o processamento não repete.
model BillingEvent {
  id                String    @id
  tipo              String
  acao              String?
  recurso_id        String?
  mp_preapproval_id String?
  payload           Json
  assinatura_ok     Boolean   @default(true)
  recebido_em       DateTime  @default(dbgenerated("now()")) @db.Timestamptz(6)
  processado_em     DateTime? @db.Timestamptz(6)
  tentativas        Int       @default(0)
  erro              String?

  @@index([mp_preapproval_id], map: "idx_billing_events_preapproval")
  @@map("billing_events")
}

// Quem já usou teste grátis / oferta de retenção. SEM relação com Decorator de
// PROPÓSITO: precisa sobreviver à exclusão da conta, senão apagar e recriar
// devolve o benefício. Guarda HMAC com pepper de ambiente, não o CNPJ em claro.
model BeneficioConsumido {
  id           String   @id @default(uuid())
  ancora_tipo  String
  ancora_hash  String
  beneficio    String
  consumido_em DateTime @default(dbgenerated("now()")) @db.Timestamptz(6)

  @@unique([ancora_tipo, ancora_hash, beneficio], map: "idx_beneficios_ancora")
  @@map("beneficios_consumidos")
}

model InventoryItem {
  id                 String            @id @default(uuid())
  decorator_id       String?
  name               String
  description        String?
  image_url          String?
  status             String?
  stock_quantity     Int?              @default(0)
  rental_price       Decimal?          @default(0.00) @db.Decimal(10, 2)
  internal_cost      Decimal?          @default(0.00) @db.Decimal(10, 2)
  created_at         DateTime          @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  decorators         Decorator?        @relation(fields: [decorator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rental_orders      RentalOrder[]
  rental_order_items RentalOrderItem[]
  party_events_quote PartyEvent[]      @relation("party_event_source_item")

  @@index([decorator_id], map: "idx_inv_decorator")
  @@map("inventory_items")
}

model RentalOrder {
  id                                             String            @id @default(uuid())
  renter_id                                      String?
  owner_id                                       String?
  total_value                                    Decimal           @db.Decimal(10, 2)
  status                                         String?           @default("Pendente")
  created_at                                     DateTime          @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  item_id                                        String?
  event_date                                     DateTime?         @db.Date
  observation                                    String?
  // Locação B2B (migração 20260829130000): retirada/devolução + confirmação da devolução.
  pickup_date                                    DateTime?         @db.Date
  return_date                                    DateTime?         @db.Date
  returned_at                                    DateTime?         @db.Timestamptz(6)
  inventory_items                                InventoryItem?    @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decorators_rental_orders_owner_idTodecorators  Decorator?        @relation("rental_orders_owner_idTodecorators", fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  decorators_rental_orders_renter_idTodecorators Decorator?        @relation("rental_orders_renter_idTodecorators", fields: [renter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rental_order_items                             RentalOrderItem[]

  @@index([owner_id], map: "idx_orders_owner")
  @@index([renter_id], map: "idx_orders_renter")
  @@map("rental_orders")
}

model RentalOrderItem {
  id              String         @id @default(uuid())
  order_id        String
  item_id         String?
  kit_id          String?
  name            String
  quantity        Int            @default(1)
  price           Decimal?       @db.Decimal(10, 2)
  rental_orders   RentalOrder    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  inventory_items InventoryItem? @relation(fields: [item_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  kits            Kit?           @relation(fields: [kit_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([order_id], map: "idx_order_items_order")
  @@map("rental_order_items")
}

model ChatMessage {
  id                                               String     @id @default(uuid())
  sender_id                                        String?
  receiver_id                                      String?
  message                                          String
  created_at                                       DateTime   @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  decorators_chat_messages_receiver_idTodecorators Decorator? @relation("chat_messages_receiver_idTodecorators", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  decorators_chat_messages_sender_idTodecorators   Decorator? @relation("chat_messages_sender_idTodecorators", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([receiver_id], map: "idx_chats_receiver")
  @@index([sender_id], map: "idx_chats_sender")
  @@map("chat_messages")
}

model Client {
  id           String       @id @default(uuid())
  decorator_id String?
  name         String
  phone        String?
  email        String?
  cpf          String?
  address      String?
  created_at   DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  decorators   Decorator?   @relation(fields: [decorator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  party_events PartyEvent[]
  client_promo_messages ClientPromoMessage[]

  @@index([decorator_id], map: "idx_clients_decorator")
  @@map("clients")
}

// Histórico de mensagens promocionais (reativação) abertas no WhatsApp. Uma
// linha por clique em Enviar — guarda o histórico completo, não só a última.
// "aberta" (não "enviada"): o sistema só sabe que o link foi aberto.
model ClientPromoMessage {
  id           String    @id @default(uuid())
  client_id    String
  decorator_id String
  sent_at      DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  phone        String
  message      String
  clients      Client    @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  decorators   Decorator @relation(fields: [decorator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([decorator_id, sent_at(sort: Desc)], map: "idx_promo_decorator_sent")
  @@index([client_id], map: "idx_promo_client")
  @@map("client_promo_messages")
}

model PartyEvent {
  id                    String         @id @default(uuid())
  client_name           String
  phone                 String?
  address               String?
  setup_time            String?
  start_time            String?
  theme                 String?
  total_value           Decimal?       @db.Decimal(10, 2)
  event_date            DateTime?      @db.Date
  status                String?
  items                 Json?
  created_at            DateTime       @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  decorator_id          String?
  client_id             String?
  public_token          String?        @unique
  source_item_id        String?
  source_kit_id         String?
  observation           String?
  submitted_at          DateTime?      @db.Timestamptz(6)
  decorators            Decorator?     @relation(fields: [decorator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clients               Client?        @relation(fields: [client_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  inventory_items_quote InventoryItem? @relation("party_event_source_item", fields: [source_item_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  kits_quote            Kit?           @relation("party_event_source_kit", fields: [source_kit_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([decorator_id], map: "idx_party_events_decorator")
  @@index([public_token], map: "idx_party_events_token")
  @@map("party_events")
}

model Kit {
  id                 String            @id @default(uuid())
  decorator_id       String?
  name               String
  description        String?
  image_url          String?
  value              Decimal?          @default(0.00) @db.Decimal(10, 2)
  items              Json?
  created_at         DateTime          @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  status             String?           @default("Privado") @db.VarChar(255)
  decorators         Decorator?        @relation(fields: [decorator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rental_order_items RentalOrderItem[]
  party_events_quote PartyEvent[]      @relation("party_event_source_kit")

  @@map("kits")
}

model consumables {
  id               String     @id
  decorator_id     String?
  name             String
  category         String
  current_quantity Int
  min_quantity     Int
  unit             String
  created_at       DateTime   @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  decorators       Decorator? @relation(fields: [decorator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model forum_posts {
  id         String     @id
  author_id  String?
  title      String
  content    String
  category   String?    @default("Geral")
  created_at DateTime   @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  decorators Decorator? @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
