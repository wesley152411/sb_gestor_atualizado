# Projeto Supabase de TESTE — NUNCA aponte para produção.
# Uso LOCAL para rodar o harness contra o banco de teste. No CI, estes valores
# vêm de GitHub Secrets (não deste arquivo). Copie para variáveis de ambiente
# reais (ex.: exporte no shell antes de `npm test`); a guarda em tests/guard.ts
# aborta se o alvo for produção ou se HARNESS_ALLOW_TEST_DB não for "true".

NEXT_PUBLIC_SUPABASE_URL=https://SEU-REF-DE-TESTE.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key-do-projeto-de-teste
DATABASE_URL=postgresql://postgres.SEU-REF-DE-TESTE:SENHA@aws-...pooler.supabase.com:6543/postgres
SUPABASE_SERVICE_ROLE_KEY=service-role-do-projeto-de-teste

# Confirma que o alvo é o banco de teste (a guarda exige). Só defina "true"
# quando as variáveis acima forem do projeto de TESTE.
HARNESS_ALLOW_TEST_DB=true

# --- Rate limiting (rotas públicas) ---
# Modo: off | observe | enforce. Subir em produção como "observe" primeiro (loga o
# IP sem bloquear), confirmar o header do IP, depois "enforce". Na Netlify/CI.
RATE_LIMIT_MODE=enforce
# Credenciais do Upstash Redis (REST). Sem elas o rate limiter fica indisponível e
# faz fail-open (a requisição passa). No CI vêm de GitHub Secrets, não deste arquivo.
UPSTASH_REDIS_REST_URL=https://SEU-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=token-do-upstash
